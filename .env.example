# Get your API key from https://console.curseforge.com/
CF_API_KEY='your-curseforge-api-key-here'

# Modpack version (e.g. 6.1, 5.5) — leave blank or "latest" for newest
#MODPACK_VERSION=6.1

# Optional: Set a world seed (leave blank or remove for random)
WORLD_SEED=testworldseed

# Server difficulty: peaceful, easy, normal, hard (leave blank for default)
#DIFFICULTY=
